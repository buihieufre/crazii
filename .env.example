# Server Port
PORT=3000

# Application Public URL (Production: https://tradewh.work | Local: http://localhost:3000)
APP_URL=https://tradewh.work
NEXT_PUBLIC_APP_URL=https://tradewh.work

# Target Crazii API Auth Bearer Token (Auto-managed from Refresh Token)
CRAZII_ACCESS_TOKEN=
CRAZII_REFRESH_TOKEN=
CRAZII_DEVICE_ID=fb70bf82-5d83-4c70-b7e6-9896bda770e7

# Google OAuth 2.0 & Session Security
GOOGLE_CLIENT_ID=
SESSION_SECRET=crazii_jwt_session_secret_key_super_secure_2026

# Supabase & PostgreSQL Prisma ORM
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# NOWPayments Crypto Gateway
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET_KEY=

# Telegram Signal Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
